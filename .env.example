# Configuration for the address-parser service (see docs/api.md).
#
# The service reads ENVIRONMENT VARIABLES. It does not load this file itself:
#   PowerShell, this session only:   $env:THIKANA_LOG_LEVEL = "DEBUG"
#   Docker:                          docker run --env-file .env ...   (or -e NAME=value)
#   Kubernetes:                      a ConfigMap
#
# There are NO SECRETS in v1: no database, no API keys, no outbound calls. Never put
# a real credential in this file; .env is gitignored and this example stays committed.

# Which trained model to serve. In the Docker image this will be a path inside it.
THIKANA_MODEL_PATH=models/crf_all_district_memory.crfsuite

# Longest accepted address, in characters. One address is a line or two, never an essay.
THIKANA_MAX_TEXT_CHARS=500

# Most addresses accepted in one /api/v1/parse/batch request.
THIKANA_MAX_BATCH=100

# Largest request body, checked on Content-Length before any parsing.
THIKANA_MAX_BODY_BYTES=65536

# DEBUG, INFO, WARNING or ERROR. Logs never contain the submitted address at any level.
THIKANA_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API. EMPTY = CORS off, the safe
# default. Example for a local front end:  http://localhost:5173,https://example.org
THIKANA_CORS_ORIGINS=

# Stamped by the build (git rev-parse --short HEAD) and shown by /api/v1/model.
THIKANA_GIT_SHA=unknown

# ---- only for a deployment on the open internet: see docs/public-hosting.md ----
# THIKANA_PUBLIC_MODE=true             # hides /metrics, /docs and the instance name
# THIKANA_RATE_LIMIT_PER_MINUTE=60     # per client, /api/* only; 0 = off
# THIKANA_RATE_LIMIT_BURST=20
# THIKANA_TRUSTED_PROXY_HOPS=0         # leave 0 until you have tested how your host forwards (see the doc)
# THIKANA_MAX_BATCH=10                 # smaller than the cluster's 100: a public caller needs less

# Which replica answered, returned in the X-Thikana-Instance header. Leave unset: the
# hostname is used (the pod name in Kubernetes). Letters, digits, . _ - only.
# THIKANA_INSTANCE=local
