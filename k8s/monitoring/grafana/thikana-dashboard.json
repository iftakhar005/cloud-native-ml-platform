{
  "uid": "thikana-overview",
  "title": "Thikana overview",
  "tags": ["thikana"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "editable": false,
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "Replicas up", "description": "Pods whose /metrics Prometheus can read. The Deployment asks for 3; below 2 is the ThikanaTooFewReplicas alert.",
     "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "count(up{job=\"thikana\"} == 1) or vector(0)", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 2}, {"color": "green", "value": 3}]}}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "Models loaded", "description": "Pods that report a loaded model. A pod that is up but at 0 here cannot parse and gets no traffic.",
     "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(thikana_model_ready) or vector(0)", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 2}, {"color": "green", "value": 3}]}}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Requests / s", "description": "API requests only (parse and model), all pods, averaged over 1 minute. Kubernetes probes and Prometheus scrapes are excluded: at idle they are ~99.5% of all requests.",
     "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(thikana_http_requests_total{route=~\"/api/.*\"}[1m])) or vector(0)", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1}, "overrides": []},
     "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "5xx share (5 m)", "description": "Server errors as a share of API requests; 0% when there are none. 4xx are the client's mistakes and are not counted; probes are excluded. Empty only when there are no API requests at all.",
     "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "(sum(rate(thikana_http_requests_total{route=~\"/api/.*\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(thikana_http_requests_total{route=~\"/api/.*\"}[5m]))", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "stat", "title": "p95 parse latency (5 m)", "description": "95th percentile of POST /api/v1/parse. Above 0.5 s is the ThikanaHighLatency alert.",
     "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(thikana_http_request_duration_seconds_bucket{route=\"/api/v1/parse\"}[5m])))", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.25}, {"color": "red", "value": 0.5}]}}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 6, "type": "stat", "title": "Alerts firing", "description": "Thikana alerts currently firing. See the table at the bottom.",
     "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"Thikana.*\"}) or vector(0)", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"id": 7, "type": "timeseries", "title": "Parse requests / s, by pod", "description": "How the load balancer spreads requests. Balancing is per CONNECTION: a few long-lived client connections give lumpy lines, many connections give even ones (docs/kubernetes.md).",
     "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (pod) (rate(thikana_http_requests_total{route=\"/api/v1/parse\"}[1m]))", "legendFormat": "{{pod}}"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "API requests / s, by status", "description": "API routes only (probes excluded). 200 is success, 422 is a rejected input, 503 is a pod with no model, 5xx is a bug.",
     "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (status) (rate(thikana_http_requests_total{route=~\"/api/.*\"}[1m]))", "legendFormat": "{{status}}"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []}},

    {"id": 9, "type": "timeseries", "title": "Parse latency percentiles", "description": "p50 / p95 / p99 of POST /api/v1/parse, computed from histogram buckets (resolution is the bucket width, not exact).",
     "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(thikana_http_request_duration_seconds_bucket{route=\"/api/v1/parse\"}[5m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(thikana_http_request_duration_seconds_bucket{route=\"/api/v1/parse\"}[5m])))", "legendFormat": "p95"},
       {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(thikana_http_request_duration_seconds_bucket{route=\"/api/v1/parse\"}[5m])))", "legendFormat": "p99"}],
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"fillOpacity": 0, "lineWidth": 2}}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "Model loaded, by pod", "description": "1 = a model is loaded, 0 = the pod is up but cannot parse (it also drops out of the Service).",
     "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "thikana_model_ready", "legendFormat": "{{pod}}"}],
     "fieldConfig": {"defaults": {"unit": "none", "min": 0, "max": 1.1, "custom": {"fillOpacity": 10, "lineWidth": 2}}, "overrides": []}},

    {"id": 11, "type": "timeseries", "title": "Entities found / s, by label", "description": "What the model is predicting. A label that vanishes or a sudden shift in the mix means the input or the model changed; no infrastructure metric can show that.",
     "gridPos": {"x": 0, "y": 20, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (label) (rate(thikana_entities_total[5m]))", "legendFormat": "{{label}}"}],
     "fieldConfig": {"defaults": {"unit": "ops", "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "Addresses with nothing found (share)", "description": "Share of parsed addresses in which NO entity was found. The ThikanaEmptyParsesHigh alert fires above 0.2 (an uncalibrated threshold).",
     "gridPos": {"x": 8, "y": 20, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(thikana_empty_parses_total[5m])) / sum(rate(thikana_addresses_parsed_total[5m]))", "legendFormat": "empty share"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.2}]}}, "overrides": []}},
    {"id": 13, "type": "timeseries", "title": "Submitted text length (chars)", "description": "Median and 95th percentile length of what people submit. A shift means the input changed (pasted documents, different formats).",
     "gridPos": {"x": 16, "y": 20, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(thikana_text_chars_bucket[5m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(thikana_text_chars_bucket[5m])))", "legendFormat": "p95"}],
     "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 0, "lineWidth": 2}}, "overrides": []}},

    {"id": 14, "type": "table", "title": "Model identity, by pod", "description": "Which model version every pod serves. They should all match; during a rollout you will briefly see two.",
     "gridPos": {"x": 0, "y": 28, "w": 10, "h": 6}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "thikana_model_info", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "namespace": true, "Value": true}}}]},
    {"id": 15, "type": "table", "title": "Alerts (firing or pending)", "description": "Empty is good.",
     "gridPos": {"x": 10, "y": 28, "w": 14, "h": 6}, "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "ALERTS{alertstate=~\"firing|pending\", alertname=~\"Thikana.*\"}", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "Value": true}}}]}
  ]
}
